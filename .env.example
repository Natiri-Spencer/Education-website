DJANGO_DEBUG=True
# Local development uses SQLite. Production setup: see .env.production.example.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY=False

# Daraja sandbox credentials. Fill these in your local .env file.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-public-domain.example/payments/mpesa/callback/
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Optional overrides; default to the bundled models/whiteboard files.
WHITEBOARD_MODEL_PATH=
WHITEBOARD_VOCAB_PATH=
# Dedicated local formula worker, enabled only after tools/check_formula.py succeeds.
WHITEBOARD_FORMULA_MODEL_DIR=
WHITEBOARD_FORMULA_PYTHON=
WHITEBOARD_FORMULA_TIMEOUT=60
WHITEBOARD_FORMULA_STARTUP_TIMEOUT=120
WHITEBOARD_FORMULA_PREWARM=true

# Transactional account email: fill privately after verifying the sender domain.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=accounts@cbestemacademy.co.ke
PUBLIC_CONTACT_EMAIL=
SUPPORT_EMAIL=
ACADEMY_DAILY_EMAIL_LIMIT=90

# Copy to .env.production. Keep that file private and out of Git.
# One bare domain: no https:// prefix, port, slash or comma.
SITE_DOMAIN=academy.example.com
ACME_EMAIL=owner@example.com
DJANGO_ALLOWED_HOSTS=academy.example.com
CSRF_TRUSTED_ORIGINS=https://academy.example.com
# Generate independent values with: python -c "import secrets; print(secrets.token_hex(32))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
# Production values below are also enforced by compose.yaml.
DJANGO_DEBUG=False
DJANGO_LOAD_DOTENV=False
DJANGO_TRUST_PROXY=True
DJANGO_HSTS_SECONDS=3600
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=180
DJANGO_LOG_LEVEL=INFO
# Windows Ink and the local Windows formula worker cannot run in Linux.
# The bundled CPU recognizer remains available; formula inference is optional.
WHITEBOARD_FORMULA_PREWARM=false

# Transactional account email: fill privately after verifying the sender domain.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=accounts@cbestemacademy.co.ke
PUBLIC_CONTACT_EMAIL=
SUPPORT_EMAIL=
ACADEMY_DAILY_EMAIL_LIMIT=90

# Enable only after check_learning_launch succeeds with real recorded approvals.
PUBLIC_REGISTRATION_ENABLED=False
